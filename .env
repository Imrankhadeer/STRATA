# Development Environment Configuration for Ternline (CYBER ENGINE)
# Pre-configured for automated verification and Google Jules environments.

ENVIRONMENT=development
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000
SECRET_KEY=cyber-engine-dev-insecure-secret-key-32chars

# Database Configuration
# In development, if PostgreSQL (localhost:5432) is not running, 
# the engine automatically falls back to local SQLite:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cyber_engine
ALLOW_SQLITE_TEST_FALLBACK=true

# Telemetry Ingestion Limits
MAX_PAYLOAD_BYTES=1048576
MAX_EVENTS_PER_BATCH=100
INGESTION_RATE_LIMIT_PER_MINUTE=1200

# Worker & Distributed State Configuration
WORKERS=1
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
REDIS_STATE_TIMEOUT_MS=500
REDIS_MAX_CONNECTIONS=50

# Deep-Investigation Configuration
INVESTIGATOR_PROVIDER=mock
INVESTIGATOR_MODEL=Llama-3.3-70B-Instruct
INVESTIGATOR_BASE_URL=https://api.llama.com/v1
INVESTIGATOR_API_KEY=mock-dev-token-llama3
INVESTIGATOR_TIMEOUT_SECONDS=30.0

ALLOW_SIMULATION_API=true
ALLOWED_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
