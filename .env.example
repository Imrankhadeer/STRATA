# Environment configuration for CYBER ENGINE (Ternline)
# Copy this file to .env and adjust variables as needed.
# NEVER commit real production secrets or API keys to version control.

# Application Environment (development, staging, production)
ENVIRONMENT=production
LOG_LEVEL=INFO

# Backend API Service Binding
HOST=0.0.0.0
PORT=8000
# Strong secret key for JWT operator session signing (>=32 characters required in production)
SECRET_KEY=generate-a-strong-32-character-secret-key-here

# Database Configuration (PostgreSQL exclusively; SQLite is strictly prohibited)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cyber_engine

# Production First-Time Bootstrap (Optional)
# If provided, the engine initializes this admin key for the initial tenant on first startup.
# If omitted on an empty database in production, the engine generates a secure key and prints it once to startup logs.
INITIAL_TENANT_ID=tenant-alpha
INITIAL_ADMIN_API_KEY=

# Engine Ingestion Settings
MAX_PAYLOAD_BYTES=1048576       # 1 MB max request size
MAX_EVENTS_PER_BATCH=100        # Max events per ingest call
INGESTION_RATE_LIMIT_PER_MINUTE=1200

# Worker Process Model & Distributed State
# Supported mode: WORKERS=1 (with single-worker correlation state)
# For horizontally scaled multi-worker production: WORKERS>1 requires REDIS_URL and Redis 7+
WORKERS=1
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
REDIS_STATE_TIMEOUT_MS=500
REDIS_MAX_CONNECTIONS=50

# Deep-Investigation Configuration (AI Incident Analysis)
# Available providers: muse | meta | openai_compatible | mock
INVESTIGATOR_PROVIDER=muse

# Official Meta Muse AI Platform (dev.meta.ai)
# Available Models: muse-spark-1.3, muse-wonder-1.0
INVESTIGATOR_BASE_URL=https://api.meta.ai/v1
INVESTIGATOR_MODEL=muse-spark-1.3
INVESTIGATOR_API_KEY=your_meta_muse_api_key_here
INVESTIGATOR_TIMEOUT_SECONDS=30.0

# Security & CORS Settings
ALLOW_SIMULATION_API=false
ALLOWED_CORS_ORIGINS=https://ternline-cyber-engine.onrender.com,http://localhost:8000


