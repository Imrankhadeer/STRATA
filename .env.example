# Environment configuration for CYBER ENGINE
# Copy this file to .env and adjust variables as needed.
# NEVER commit real production secrets to version control.

# Application Environment (development, testing, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Service
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-in-production-use-a-strong-secret-key-32chars

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/cyber_engine

# For local tests without Docker/PostgreSQL running, setting this to true allows
# automated in-memory SQLite fallback testing while keeping Alembic migrations configured for PostgreSQL:
ALLOW_SQLITE_TEST_FALLBACK=true

# Engine Ingestion Settings
MAX_PAYLOAD_BYTES=1048576       # 1 MB max request size
MAX_EVENTS_PER_BATCH=100        # Max events per ingest call
# Ingestion Rate Limiting
INGESTION_RATE_LIMIT_PER_MINUTE=1200

# Worker Process Model & Distributed State
# For single-process local development: WORKERS=1, REDIS_REQUIRED=false
# For horizontally scaled production: WORKERS>1 requires REDIS_URL and Redis 7+
WORKERS=1
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false
REDIS_STATE_TIMEOUT_MS=500
REDIS_MAX_CONNECTIONS=50

# Deep-Investigation Configuration
# Available providers: mock | meta | openai_compatible
INVESTIGATOR_PROVIDER=mock

# Official Meta Model API Settings (https://api.llama.com/v1)
# Supported verified Meta models:
#   - Llama-3.3-70B-Instruct (Recommended flagship for deep investigation)
#   - Llama-3.1-405B-Instruct
#   - Llama-3.1-70B-Instruct
#   - Llama-3.1-8B-Instruct
#   - Llama-3.2-3B-Instruct / Llama-3.2-1B-Instruct
#   - Llama-Guard-3-8B (Safety classification)
INVESTIGATOR_BASE_URL=https://api.llama.com/v1
INVESTIGATOR_API_KEY=
INVESTIGATOR_MODEL=Llama-3.3-70B-Instruct
INVESTIGATOR_TIMEOUT_SECONDS=30.0
