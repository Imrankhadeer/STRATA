# ==============================================================================
# Ternline Security Engine - Production Environment Configuration
# Target Infrastructure: AWS (ECS Fargate / EC2 / RDS / ElastiCache / SES) + Vercel
# ==============================================================================

# Core Application Runtime
ENVIRONMENT=production
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Cryptographic Secret Key (Must be >= 32 characters, generated via openssl rand -hex 32)
SECRET_KEY=generate_with_openssl_rand_hex_32_chars_minimum_here

# Telemetry Ingestion Limits
MAX_PAYLOAD_BYTES=1048576
MAX_EVENTS_PER_BATCH=100
INGESTION_RATE_LIMIT_PER_MINUTE=1200

# PostgreSQL Database (AWS RDS PostgreSQL 16)
# Note: SQLite is strictly prohibited. Use sslmode=require for AWS RDS.
DATABASE_URL=postgresql+psycopg2://ternline_admin:STRONG_RDS_PASSWORD@ternline-db.xxxxxxxxx.us-east-1.rds.amazonaws.com:5432/cyber_engine?sslmode=require

# Distributed Correlation & State Store (AWS ElastiCache Redis 7+)
# Use rediss:// if ElastiCache in-transit encryption (TLS) is enabled.
REDIS_URL=rediss://:STRONG_REDIS_AUTH_TOKEN@ternline-redis.xxxxxx.clustercfg.use1.cache.amazonaws.com:6379/0
REDIS_REQUIRED=true
REDIS_STATE_TIMEOUT_MS=500
REDIS_MAX_CONNECTIONS=50

# Frontend & CORS Configuration (Vercel Hosting)
# ALLOWED_CORS_ORIGINS: Comma-separated allowlist of custom production domains
ALLOWED_CORS_ORIGINS=https://ternline.vercel.app,https://yourdomain.com
CORS_ALLOW_VERCEL=true
FRONTEND_URL=https://ternline.vercel.app

# Email Delivery Configuration (AWS SES or SMTP)
AWS_REGION=us-east-1
AWS_SES_SOURCE=noreply@ternline.io
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1

# Optional Fallback SMTP (if not using AWS SES directly)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ternline.io
SMTP_TLS=true

# Initial Bootstrapping Admin API Key (Provisioned once on first database boot)
INITIAL_ADMIN_API_KEY=ce_live_prod_super_secret_initial_key_replace_me
INITIAL_TENANT_ID=tenant-alpha

# Deep-Track AI Investigation Engine (Meta / Muse / OpenAI compatible)
INVESTIGATOR_PROVIDER=muse
INVESTIGATOR_BASE_URL=https://api.meta.ai/v1
INVESTIGATOR_MODEL=muse-spark-1.3
INVESTIGATOR_API_KEY=your_production_investigator_api_key_here
INVESTIGATOR_TIMEOUT_SECONDS=30.0

# Operational Guardrails (Strictly enforced in production)
ALLOW_SIMULATION_API=false
ASYNC_INGESTION_ENABLED=true
ASYNC_QUEUE_KEY=cyber_engine:telemetry_queue

